#define VS_FF_NONE 0
1 VERSIONINFO
FILEVERSION @VERSIONC@
PRODUCTVERSION @VERSIONC@
FILEOS 0x40004
FILETYPE 2
FILESUBTYPE 2
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "000004B0"
    BEGIN
      VALUE "CompanyName", "avtotrainer"
      VALUE "FileDescription", "@DESC@ Keyboard Layout"
      VALUE "FileVersion", "@VERSION4@"
      VALUE "InternalName", "@DLL@"
      VALUE "LegalCopyright", "(c) 2026 avtotrainer"
      VALUE "OriginalFilename", "@DLL@.dll"
      VALUE "ProductName", "@TEXT@"
      VALUE "ProductVersion", "@VERSION4@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0000, 0x04B0
  END
END

STRINGTABLE
BEGIN
  1000 "@TEXT@"
END
